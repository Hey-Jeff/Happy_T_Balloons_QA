# Copiar a .env (ignorado por Git) y completar con valores de un entorno QA. NUNCA subir credenciales.
# En GitHub Actions estos valores vienen de Settings → Secrets and variables → Actions.

# Instancia QA compartida (HTTP). Solo flujos de lectura / rechazo; sin escrituras de negocio.
QA_BASE_URL=http://13.184.33.122
QA_ALLOW_HTTP=true
# true solo para ejecutar UN caso autenticado a la vez (npm run test:case -- ID --try-drafts).
QA_ALLOW_HTTP_AUTH=false

# Cuentas QA desechables (HTTP no cifra credenciales).
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_CLIENT_EMAIL=
QA_CLIENT_PASSWORD=

# Escrituras: SOLO en una instancia QA aislada y restaurable (ver docs/QA02_AUDITORIA_Y_CORRECCIONES.md §7 y §10).
QA_ALLOW_MUTATIONS=false
QA_ISOLATED_QA=false
QA_RESETTABLE_DB=NO
# QA_ISOLATED_BASE_URL=https://qa-aislado.example.test/
# QA_LOCKOUT_EMAIL=              # cuenta desechable para AUT-002 / AUT-003
# QA_INVALID_PASSWORD=           # AUT-002: un solo intento
# QA_CATEGORY_WITH_PRODUCTS=     # CATE-012
